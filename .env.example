# ─────────────────────────────────────────────
#  Personal Economy — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# MySQL
DB_PASSWORD=rootpassword

# ─────────────────────────────────────────────
#  Discord Setup Guide
# ─────────────────────────────────────────────
#
#  Step 1 — Create a Discord Application
#    → https://discord.com/developers/applications
#    → Click "New Application", give it a name
#
#  Step 2 — Create a Bot
#    → Go to the "Bot" tab → click "Add Bot"
#    → Under "Privileged Gateway Intents", enable:
#        ✅ MESSAGE CONTENT INTENT
#
#  Step 3 — Get your Bot Token
#    → On the "Bot" tab, click "Reset Token" → copy it
#    → Paste below as DISCORD_TOKEN
#
#  Step 4 — Invite the bot to your server
#    → Go to "OAuth2" → "URL Generator"
#    → Scopes: bot
#    → Permissions: Read Messages, Send Messages, Read Message History
#    → Open the generated URL → add bot to your server
#
#  Step 5 — Get your finance channel ID
#    → In Discord, go to Settings → Advanced → Enable Developer Mode
#    → Right-click the channel you want to use → "Copy Channel ID"
#    → Paste below as DISCORD_CHANNEL_ID
#
# ─────────────────────────────────────────────

DISCORD_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=your-channel-id-here
